# --- Ethereum Sepolia ---
SEPOLIA_RPC=                # Infura/Alchemy HTTPS endpoint
DEPLOYER_PRIVATE_KEY=       # funded with Sepolia ETH, used to deploy SalaryStream.sol

# --- Creditcoin CC3 Testnet ---
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
WORKER_PRIVATE_KEY=         # funded with tCTC (CC3 faucet), submits proofs to StreamVerifierASC
CC3_DEPLOYER_PRIVATE_KEY=   # funded with tCTC, deploys ASC/CreditPool/EmployerRegistry/TestUSDC

# --- Attestcoin Protocol ---
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# --- Deployed contract addresses (fill in after `forge script` deploys) ---
STREAM_CONTRACT=            # SalaryStream.sol on Sepolia
ASC_CONTRACT=                # StreamVerifierASC.sol on CC3 Testnet
CREDIT_POOL_CONTRACT=
EMPLOYER_REGISTRY_CONTRACT=
TEST_USDC_CONTRACT=
PRICE_ORACLE_CONTRACT=      # FixedPriceOracle.sol on CC3 Testnet, ETH/USD price CreditPool reads

# --- Deploy-time only (not read at runtime) ---
# ORACLE_INITIAL_PRICE=300000000000  # optional, 8 decimals, USD per ETH, defaults to 3000e8

# --- apps/web ---
NEXT_PUBLIC_CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_ASC_CONTRACT=
NEXT_PUBLIC_CREDIT_POOL_CONTRACT=
