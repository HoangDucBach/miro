# --- Ethereum Sepolia ---
# Infura/Alchemy HTTPS endpoint
SEPOLIA_RPC=
# funded with Sepolia ETH, deploys the demo Morpho assets, plays the Sepolia-side role in e2e.ts
DEPLOYER_PRIVATE_KEY=

# --- Creditcoin CC3 Testnet ---
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
# funded with tCTC (CC3 faucet), submits proofs to CreditPassport
WORKER_PRIVATE_KEY=
# funded with tCTC, deploys CreditPassport/PassportPool/TestUSDC/FixedPriceOracle, owns CreditPassport (registers sources) and PassportPool
CC3_DEPLOYER_PRIVATE_KEY=

# --- Attestcoin Protocol ---
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# --- Worker queue (BullMQ) ---
# docker-compose overrides this to redis://redis:6379
REDIS_URL=redis://localhost:6379
# First run only: blocks before the head to scan for source events. A restart resumes
# its saved cursor instead. ~300 blocks is an hour on Sepolia.
SCAN_LOOKBACK_BLOCKS=0
# how many relay jobs the worker processes in parallel
WORKER_CONCURRENCY=5

# --- Real, unmodified lending protocols on Sepolia (not ours -- see docs/attestcoin-integration.md) ---
AAVE_POOL_CONTRACT=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
AAVE_FAUCET_CONTRACT=0xC959483DBa39aa9E78757139af0e9a2EDEb3f42D
# LINK -- DAI/USDC/USDT all sit above their 2B supply cap from public testnet usage; LINK/WETH/WBTC have no cap
AAVE_RESERVE_ASSET_CONTRACT=0xf8Fb3713D459D7C1018BD0A49D19b4C44290EBE5
MORPHO_CONTRACT=0xd011ee229e7459ba1ddd22631ef7bf528d424a14
# AdaptiveCurveIRM, re-verify enabled at deploy time
MORPHO_IRM_CONTRACT=0x8c5ddcd3f601c91d1bf51c8ec26066010acaba7c

# --- Demo Morpho market assets (contracts/source, fill in after `forge script` deploys) ---
DEMO_LOAN_TOKEN_CONTRACT=
DEMO_COLLATERAL_TOKEN_CONTRACT=
MORPHO_ORACLE_CONTRACT=

# --- Deployed contract addresses (CC3 Testnet, fill in after `forge script` deploys) ---
CREDIT_PASSPORT_CONTRACT=
PASSPORT_POOL_CONTRACT=
TEST_USDC_CONTRACT=
# FixedPriceOracle.sol on CC3 Testnet, native tCTC/USD price PassportPool reads
PRICE_ORACLE_CONTRACT=

# --- Deploy-time only (not read at runtime) ---
# ORACLE_INITIAL_PRICE=100000000  # optional, 8 decimals, USD per tCTC, defaults to 1e8

# --- apps/web ---
# same value as SEPOLIA_RPC above -- Next only exposes NEXT_PUBLIC_* to the browser
NEXT_PUBLIC_SEPOLIA_RPC=
NEXT_PUBLIC_CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_CREDIT_PASSPORT_CONTRACT=
NEXT_PUBLIC_PASSPORT_POOL_CONTRACT=
NEXT_PUBLIC_TEST_USDC_CONTRACT=
NEXT_PUBLIC_PRICE_ORACLE_CONTRACT=

# Block CreditPassport was deployed at. Optional but effectively required: the passport
# page reads its source registry out of SourceSet/LocalReporterSet logs, and CC3's public
# RPC caps eth_getLogs at a 10-second query -- scanning from block 0 is refused outright.
# Without this the scan falls back to a recent window and finds nothing. Locate it with a
# binary search over eth_getCode against the deployed address.
NEXT_PUBLIC_CREDIT_PASSPORT_DEPLOY_BLOCK=

# Source protocols on Sepolia -- read in "Loans on other chains", and repaid from there.
# The Aave entries cover repayment as well as display: the reserve asset is what gets
# approved, the variable debt token's balanceOf is the exact debt, and the faucet is
# public so a wallet short of interest can top itself up. Morpho addresses a market by its
# five parameters on every write; the market id is derived from them in lib/morpho.ts.
NEXT_PUBLIC_AAVE_POOL_CONTRACT=
NEXT_PUBLIC_AAVE_RESERVE_ASSET_CONTRACT=
NEXT_PUBLIC_AAVE_VARIABLE_DEBT_TOKEN=
NEXT_PUBLIC_AAVE_FAUCET_CONTRACT=
NEXT_PUBLIC_MORPHO_CONTRACT=
NEXT_PUBLIC_MORPHO_LOAN_TOKEN_CONTRACT=
NEXT_PUBLIC_MORPHO_COLLATERAL_TOKEN_CONTRACT=
NEXT_PUBLIC_MORPHO_ORACLE_CONTRACT=
NEXT_PUBLIC_MORPHO_IRM_CONTRACT=
NEXT_PUBLIC_MORPHO_LLTV=
