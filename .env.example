# --- Ethereum Sepolia ---
SEPOLIA_RPC=                # Infura/Alchemy HTTPS endpoint
DEPLOYER_PRIVATE_KEY=       # funded with Sepolia ETH, deploys NebulaToken.sol, plays the token-grantor role in e2e.ts

# --- Creditcoin CC3 Testnet ---
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
WORKER_PRIVATE_KEY=         # funded with tCTC (CC3 faucet), submits proofs to StreamVerifierASC
CC3_DEPLOYER_PRIVATE_KEY=   # funded with tCTC, deploys ASC/CreditPool/TestUSDC/FixedPriceOracle, owns CreditPool (whitelists collateral tokens)

# --- Attestcoin Protocol ---
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# --- Worker queue (BullMQ) ---
REDIS_URL=redis://localhost:6379   # docker-compose overrides this to redis://redis:6379
WORKER_CONCURRENCY=5                # how many relay jobs the worker processes in parallel

# --- Deployed contract addresses ---
SABLIER_LOCKUP_CONTRACT=    # Sablier's real, unmodified SablierLockup deployment on Sepolia (not ours -- see docs/attestcoin-integration.md)
NEBULA_TOKEN_CONTRACT=      # NebulaToken.sol on Sepolia, demo collateral token (fill in after `forge script` deploys)
ASC_CONTRACT=                # StreamVerifierASC.sol on CC3 Testnet
CREDIT_POOL_CONTRACT=
TEST_USDC_CONTRACT=
PRICE_ORACLE_CONTRACT=      # FixedPriceOracle.sol on CC3 Testnet, NEBULA/USD price CreditPool reads

# --- Deploy-time only (not read at runtime) ---
# ORACLE_INITIAL_PRICE=300000000000  # optional, 8 decimals, USD per NEBULA, defaults to 3000e8

# --- apps/web ---
NEXT_PUBLIC_CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_ASC_CONTRACT=
NEXT_PUBLIC_CREDIT_POOL_CONTRACT=
